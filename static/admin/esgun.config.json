{
  "root": "dist",
  "outdir": "dist/js",
  "resolve": [
    "vendor/node_modules"
  ],
  "entry": [
    "assets/js/main.js",
    "assets/js/code-editor.js",
    "assets/js/richtext-editor.js",
    "assets/js/visual-editor.js",
    "assets/js/views/*.js"
  ],
  "copies": [
    {
      "from": "assets/static",
      "to": "dist"
    },
    {
      "from": "assets/css/style.css",
      "to": "dist/style.css"
    },
    {
      "from": "assets/css/richtext.css",
      "to": "dist/richtext.css"
    },
    {
      "from": "vendor/node_modules/@knadh/oat/oat.min.css",
      "to": "dist/oat.min.css"
    }
  ],
  "gzip": {
    "extensions": [
      ".js",
      ".css",
      ".svg"
    ],
    "level": 9,
    "removeOriginal": true
  },
  "preserveRoot": true,
  "watch": [
    "assets"
  ]
}
